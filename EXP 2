#include <math.h>

int main()

{
    int n, i, j, temp;
    int sum=0;
    scanf("%d", &n);

    int calories[n];

    for (i = 0; i < n; i++)
    {
        scanf("%d", &calories[i]);
    }
    for (i = 0; i < n ; i++)
   
    {
        for (j = i+1; j < n; j++)
        {
            if (calories[i] < calories[j])
            {
                temp = calories[i];
                calories[i] = calories[j];
                calories[j] = temp;
            }
        }
   }

   
    for (i = 0; i < n; i++)
    {
       
