4-G-Array Sum max problem

Given an array of N integer, we have to maximize the sum of arr[i] * i, where i is the index of the element (i = 0, 1, 2, ..., N).Write an algorithm based on Greedy technique with a Complexity O(nlogn).

 Input Format:

First line specifies the number of elements-n
The next n lines contain the array elements.

Output Format:

Maximum Array Sum to be printed.

Sample Input:
5
2 5 3 4 0

Sample output:
40

CODE:
#include <stdio.h>

int main() {
    int n, temp;
    long long sum = 0;

    scanf("%d", &n);

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    
    for (int i = 0; i < n - 1; i++) {
        for (int j = i + 1; j < n; j++) {
            if (arr[i] > arr[j]) {
                temp = arr[i];
                arr[i] = arr[j];
                arr[j] = temp;
            }
        }
    }

   
    for (int i = 0; i < n; i++) {
        sum += arr[i] * i;
    }

    printf("%lld", sum);

    return 0;
}

